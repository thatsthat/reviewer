generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Apple {
  appId       String   @id @map("app_id")
  title       String
  description String?
  url         String?
  iconUrl     String?  @map("icon_url")
  scrapedAt   DateTime @default(now()) @map("scraped_at") @db.Timestamptz()
  data        Json

  link AppsAppleLink?

  @@map("apple")
}

model Google {
  appId       String   @id @map("app_id")
  title       String
  description String?
  url         String?
  iconUrl     String?  @map("icon_url")
  scrapedAt   DateTime @default(now()) @map("scraped_at") @db.Timestamptz()
  data        Json

  link AppsGoogleLink?

  @@map("google")
}

model App {
  id        Int      @id @default(autoincrement())
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz()

  appleLinks  AppsAppleLink[]
  googleLinks AppsGoogleLink[]

  @@map("apps")
}

model AppsAppleLink {
  appleAppId String @id @map("apple_app_id")
  appId      Int    @map("app_id")

  apple Apple @relation(fields: [appleAppId], references: [appId], onDelete: Cascade, onUpdate: NoAction)
  app   App   @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([appId])
  @@map("apps_apple_links")
}

model AppsGoogleLink {
  googleAppId String @id @map("google_app_id")
  appId       Int    @map("app_id")

  google Google @relation(fields: [googleAppId], references: [appId], onDelete: Cascade, onUpdate: NoAction)
  app    App    @relation(fields: [appId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([appId])
  @@map("apps_google_links")
}
